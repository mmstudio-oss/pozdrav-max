# MAX
BOT_TOKEN=PASTE_YOUR_MAX_BOT_TOKEN_HERE
FRONTEND_ORIGIN=https://YOUR-GITHUB-LOGIN.github.io
INIT_DATA_MAX_AGE_SECONDS=86400

# Yandex AI Studio
YANDEX_API_KEY=PASTE_YOUR_YANDEX_AI_STUDIO_API_KEY_HERE
YANDEX_FOLDER_ID=PASTE_YOUR_FOLDER_ID_HERE

# Для проверки через обычный браузер:
# true  -> можно тестировать генерацию прямо с GitHub Pages
# false -> генерация только через MAX Mini App
ALLOW_BROWSER_AI_GENERATION=true

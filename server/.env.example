# Секреты храните ТОЛЬКО на сервере/в Timeweb. Не добавляйте реальные значения в GitHub.

BOT_TOKEN=PASTE_YOUR_MAX_BOT_TOKEN_HERE

# Если сайт https://ivan123.github.io/pozdrav-max/
# укажите только origin, без пути:
FRONTEND_ORIGIN=https://YOUR-GITHUB-LOGIN.github.io

# Yandex AI Studio
YANDEX_API_KEY=PASTE_YOUR_YANDEX_AI_STUDIO_API_KEY_HERE
YANDEX_FOLDER_ID=PASTE_YOUR_YANDEX_FOLDER_ID_HERE

# 86400 = MAX initData считается допустимым до 24 часов
INIT_DATA_MAX_AGE_SECONDS=86400

# Для продакшена оставьте false.
# true можно временно включить только для теста генерации из обычного браузера.
ALLOW_BROWSER_AI_GENERATION=false

# MAX
BOT_TOKEN=PASTE_YOUR_MAX_BOT_TOKEN_HERE
FRONTEND_ORIGIN=https://YOUR-GITHUB-LOGIN.github.io
INIT_DATA_MAX_AGE_SECONDS=86400

# Облачная фотобаза в российском Timeweb S3.
# Пример:
# https://my-pozdrav-bucket.s3.twcstorage.ru/manifest.json
PHOTO_LIBRARY_MANIFEST_URL=https://YOUR-BUCKET.s3.twcstorage.ru/manifest.json

# Yandex AI Studio
YANDEX_API_KEY=PASTE_YOUR_YANDEX_AI_STUDIO_API_KEY_HERE
YANDEX_FOLDER_ID=PASTE_YOUR_FOLDER_ID_HERE

# Для теста через обычный браузер:
ALLOW_BROWSER_PREVIEW=true

# После проверки внутри MAX лучше:
# ALLOW_BROWSER_PREVIEW=false
